# Set these in the managed kiosk account's environment, not in browser storage.
BIOMETRIC_HR_URL=https://your-hr-server.example
BIOMETRIC_DEVICE_SN=
BIOMETRIC_DEVICE_CREDENTIAL_FILE=
BIOMETRIC_PRIVATE_KEY_FILE=
BIOMETRIC_QUEUE_KEY_FILE=
BIOMETRIC_SPOOL_DIR=
# Optional CA files: omit variables to use the operating system trust store.
# BIOMETRIC_CA_FILE=
# SECUGEN_CA_FILE=
SECUGEN_URL=https://localhost:8000/SGIFPCapture
SECUGEN_LICENSE_ORIGIN=
SECUGEN_SCANNER_SERIAL=
# Set only when required by your SecuGen WebAPI licence.
# SECUGEN_LICENSE=
BIOMETRIC_CAMERA_INDEX=0
# Set instead of camera index only after confirming an accessible camera stream.
# BIOMETRIC_CAMERA_URI=rtsp://camera-address/verified-stream-path
