generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveAccrualPeriod {
  NONE
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum StatusAttendance {
  PRESENT
  ABSENT
  LATE
  HALF_DAY // check-in later than shift-start + HALF_DAY grace (default 30 min)
  // HR-ATT-POLICY-01 — a punch pair that never completed. These are BLOCKING
  // states, not shades of present: day_credit stays null and
  // requires_regularization is set, so payroll holds the day instead of
  // silently paying zero. They outrank LATE in the single-valued `status`
  // column; the lateness itself is still recorded as a LATE_CHECKIN anomaly.
  MISSING_CHECKIN
  MISSING_CHECKOUT
}

// Attendance anomaly / correction requests — the "Inform Abnormality" action and
// the Timesheet pending-approvals feed. Employee-raised; HR approves/rejects.
enum AnomalyType {
  LATE_CHECKIN
  MISSING_CHECKIN
  MISSING_CHECKOUT
  EARLY_CHECKOUT
  ABSENT
  OTHER
}

enum AnomalyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  REJECTED
  APPROVED
}

enum ReviewStatus {
  IN_PROGRESS
  FINALIZED
  DRAFT
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CLOSED
}

enum CourseMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Certification lifecycle for the Certifications & Transcripts screen KPIs.
// ACTIVE   — valid, not expired.
// RENEWAL  — due for renewal (expiring soon / renewal in progress).
// INACTIVE — archived/revoked/superseded (not counted as active).
// EXPIRED  — past expiryDate. NOTE: expiry is ALSO derived dynamically from
//            expiryDate at read time so a stale ACTIVE row past its date still
//            counts as expired in the KPIs.
enum CertificationStatus {
  ACTIVE
  RENEWAL
  INACTIVE
  EXPIRED
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
}

enum ReminderType {
  PENDING_REVIEW
  LATE_SUBMISSION
  FEEDBACK_REQUEST
}

enum ReviewType {
  SELF
  MANAGER
  PEER
  HR
}

enum CalibrationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PayrollRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  APPROVED // HR-02 / T-P4.1 — human-approved (distinct approver) and ready to FINALIZE
  FINALIZED // HR-02 / T-P4.1 — finalized after approval; payslips locked for distribution
  CANCELLED
  FAILED
}

enum PayslipStatus {
  DRAFT // pending (not yet approved)
  APPROVED // approved for disbursement
  HOLD // held back (blocking issue / manual hold)
  FINALIZED // run finalized / locked
  DISTRIBUTED // disbursed to the employee
}

enum PayElementType {
  EARNING
  DEDUCTION
}

enum PayFrequency {
  WEEKLY
  BI_WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

// Payroll Setup — how a salary component's amount is derived.
enum ComputationType {
  FIXED // a flat amount (value)
  PERCENTAGE // value% of the reference base (BASIC/GROSS)
  FORMULA // safe-evaluated expression (payrollFormula.js)
}

// Payroll Setup — draft/publish lifecycle for the whole config set (PayrollConfigMeta).
enum ConfigStatus {
  DRAFT
  PUBLISHED
}

// Payroll Setup — row-level active/inactive toggle shown in the tax-slab and
// approval-matrix tables (enable/disable without deleting).
enum RowStatus {
  ACTIVE
  INACTIVE
}

// Payroll Setup — anchor for a Cycle & Calendar boundary (period start/end, pay date).
enum CalendarAnchor {
  FIXED_DATE // an explicit date is supplied
  FIRST_OF_MONTH // day 1 of the month
  LAST_OF_MONTH // last day of the month
}

enum TimeEntryType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
  MANUAL_ENTRY
}

enum WorkType {
  REGULAR
  OVERTIME
  HOLIDAY
  VACATION
  SICK
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// F-03 / ARCH-01 §3.5, §7-§9 — HR-owned system-account workflow states.
enum SystemAccountProvisioningStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  SUCCEEDED
  TERMINAL_FAILED
}

// ==================== MODELS ====================

model DashboardLayout {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  dashboardType String   @default("workforce")
  layout        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([tenantId, employeeId, dashboardType])
  @@index([tenantId])
}

model Employee {
  id                   Int       @id @default(autoincrement())
  tenant_id            String?   @db.Uuid // REQ-007 — RBAC Company.uuid (was Int companyId)
  first_name           String?
  middle_name          String?
  last_name            String?
  preferred_name       String?
  nationality_id_type  String?
  employee_code        String?   @db.VarChar(50)
  biometric_id         String?   @db.VarChar(64) // ZKTeco device enrollment user-ID; attendance punches join on this (falls back to employee_code). Bulk-import "Biometric / Device ID".
  personId             String?   @db.Uuid // Phase A: cross-tenant identity anchor → RBAC Person.id (enforced at app layer, not DB FK — cross-database)
  login_password       String? // C4-encrypted (AES-256-GCM envelope) copy of the auto-generated login password, for HR read-back via hr_employee_login_password_get. RBAC holds the real hash.
  date_of_birth        DateTime?
  joining_date         DateTime?
  probation_end_date   DateTime?
  employee_type        String? // contract permenant etc..
  work_mode            String? // Remote | Onsite | Hybrid
  remarks              String?   @db.Text
  marital_status       String?
  nationality          String?
  nationality_id_no    String?
  nationality_id       Int?
  current_address      String?   @db.Text
  permenant_address    String?   @db.Text
  city                 String?
  state                String?
  province             String?
  country              String?
  postal_code          String?
  personal_contact     String?
  email                String?
  work_email           String?
  work_phone           String?
  employement_status   String? // Active/ Inactive
  photo_url            String?
  cover_photo_url      String?
  cover_photo_media_id Int?
  updatedById          Int?
  createdById          Int?
  additional_fields    Json?
  gender               String?
  job_title            String?
  hire_date            DateTime?
  status               String?
  userId               Int?
  employee_media_id    Int?
  employee_name        String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // API-2 — optimistic-concurrency guard. Bumped on every _update write; a
  // caller-supplied expectedVersion that no longer matches → HR-4120 (412).
  version Int @default(0)

  // NEW FIELDS
  // Pakistan National Tax Number. Additive nullable; C4-encrypted at rest via the
  // prisma C4 extension (C4_FIELDS.employee.ntn) — plaintext string in memory.
  ntn            String?
  businessUnitId Int? // Business Unit / Platform
  gradeLevelId   Int? // Employee Grade
  managerId      Int? // Direct Supervisor (Manager)
  reportToId     Int? // Functional Reporting (if different from manager)
  fte            Float? // Full-Time Equivalent (0.0–1.0)
  tenureMonths   String? // Tenure in months (system-calculated)

  // Existing relations
  emergencyContact      EmergencyContacts[]     @relation("RelationWithEmployee")
  attendance            Attendance[]
  leaves                Leave[]
  reviewsGiven          PerformanceReview[]     @relation("Reviewer")
  reviewsReceived       PerformanceReview[]     @relation("EmployeeReviews")
  feedbackGiven         ReviewFeedback[]        @relation("FeedbackByEmployee")
  Position              Position?               @relation(fields: [positionId], references: [id])
  positionId            Int?
  requisitionsRequested JobRequisition[]        @relation("RequestedBy")
  requisitionsApproved  JobRequisition[]        @relation("ApprovedBy")
  approvals             RequisitionApproval[]
  JobRequisition        JobRequisition[]
  TrainingCourse        TrainingCourse[]
  coursesCreated        TrainingCourse[]        @relation("CourseCreatedBy")
  courseReviews         CourseReview[]
  attendanceAnomalies   AttendanceAnomaly[]
  payrollApprovalRoles  PayrollApprovalMatrix[] @relation("PayrollApprover")

  // HR-ATT-POLICY-01
  attendanceAnomalyApprovals AttendanceAnomalyApproval[] @relation("AttendanceAnomalyApprover")
  attendanceApprovalRoles    AttendanceApprovalLevel[]   @relation("AttendanceApprover")
  claimApprovals        ClaimApproval[]         @relation("ClaimApprover")
  TrainingEnrollment    TrainingEnrollment[]
  // positionCreatedBy     Position[]            @relation("CreatedBy")
  actionBy              Log[]                   @relation("ActionBy")
  logs                  Log[]
  goalCreatedBy         Goal[]                  @relation("GoalCreatedBy")
  approvedBy            Goal[]                  @relation("GoalApprover")
  goalProgress          GoalProgress[]          @relation("GoalProgressCreatedBy")
  feedBackBy            ReviewFeedback[]        @relation("FeedbackBy")
  ReviewReminder        ReviewReminder[]
  calibratedBy          RatingAdjustment[]      @relation("CalibratedBy")

  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  gradeLevel   GradeLevel?   @relation(fields: [gradeLevelId], references: [id])
  manager      Employee?     @relation("ManagerRelation", fields: [managerId], references: [id])
  reportTo     Employee?     @relation("ReportToRelation", fields: [reportToId], references: [id])
  teamMembers  Employee[]    @relation("ManagerRelation")
  reports      Employee[]    @relation("ReportToRelation")

  // Payroll relations
  payrollPayslips    PayrollPayslip[]
  employmentTerms    EmploymentTerms[]
  payrollAssignments PayrollAssignment[]
  bankDetails        BankDetail[]
  PayrollAuditLog    PayrollAuditLog[]
  TimeEntry          TimeEntry[]
  Timesheet          Timesheet[]
  TimeApproval       TimeApproval[]
  WorkSchedule       WorkSchedule[]
  loans              Loan[]

  // Leave Management relations
  leavePoliciesCreated     LeavePolicy[]             @relation("LeavePolicyCreatedBy")
  leavePoliciesUpdated     LeavePolicy[]             @relation("LeavePolicyUpdatedBy")
  leaveRequestsCreated     LeaveRequest[]            @relation("LeaveRequestCreatedBy")
  leaveRequestsUpdated     LeaveRequest[]            @relation("LeaveRequestUpdatedBy")
  approvalWorkflowsCreated ApprovalWorkflow[]        @relation("ApprovalWorkflowCreatedBy")
  approvalWorkflowsUpdated ApprovalWorkflow[]        @relation("ApprovalWorkflowUpdatedBy")
  holidayCalendarsCreated  HolidayCalendar[]         @relation("HolidayCalendarCreatedBy")
  holidayCalendarsUpdated  HolidayCalendar[]         @relation("HolidayCalendarUpdatedBy")
  holidaysCreated          Holiday[]                 @relation("HolidayCreatedBy")
  holidaysUpdated          Holiday[]                 @relation("HolidayUpdatedBy")
  leaveBalancesUpdated     LeaveBalance[]            @relation("LeaveBalanceUpdatedBy")
  leaveRequestApprovals    LeaveRequestApproval[]    @relation("LeaveRequestApprovalCreatedBy")
  employeeHolidayCalendars EmployeeHolidayCalendar[]

  // Direct relations for leave management
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  approvedLeaveRequests LeaveRequestApproval[]
  region                Region?                @relation(fields: [regionId], references: [id])
  regionId              Int?
  regionsCreated        Region[]               @relation("RegionCreatedBy")
  regionsUpdated        Region[]               @relation("RegionUpdatedBy")
  employee_media        EmployeeMedia[]        @relation("employeeMedia")
  dashboardLayouts      DashboardLayout[]

  // Onboarding relations
  onboardingChecklists      OnboardingChecklist[]
  onboardingDocuments       OnboardingDocument[]
  onboardingSurveys         OnboardingSurvey[]
  buddyAssignments          OnboardingBuddy[]     @relation("BuddyRelation")
  onboardingTaskAssignments OnboardingTask[]      @relation("OnboardingTaskAssignee")
  onboardingFeedbacks       OnboardingFeedback[]  @relation("OnboardingFeedbackEmployee")

  // Recruitment relations
  interviewPanels          InterviewInterviewer[]
  interviewScorecardsGiven InterviewScorecard[]   @relation("ScorecardReviewer")

  // Learning & Development relations
  certifications          Certification[]
  recognitions            Recognition[]
  facilitatedSessions     TrainingSession[]         @relation("SessionFacilitator")
  sessionAttendances      TrainingSessionAttendee[]
  learningPathEnrollments LearningPathEnrollment[]

  // Employee management relations
  skills                   EmployeeSkill[]
  lifecycleEvents          EmployeeLifecycleEvent[]
  offboardingChecklist     OffboardingChecklist?
  offboardingTasksAssigned OffboardingTask[]

  // Compliance, IDP, Reimbursement relations
  complianceItems        ComplianceItem[]
  developmentPlans       DevelopmentPlan[]
  reimbursementClaims    ReimbursementClaim[]  @relation("ReimbursementEmployee")
  reimbursementsApproved ReimbursementClaim[]  @relation("ReimbursementApprover")
  documentExpiryAlerts   DocumentExpiryAlert[]
  // HR-BENEFITS-04 — benefit enrollments for this employee.
  benefitEnrollments     EmployeeBenefit[]     @relation("EmployeeBenefits")

  @@index([biometric_id])
  @@index([personId])
  @@index([positionId])
  @@index([businessUnitId])
  @@index([gradeLevelId])
  @@index([managerId])
  @@index([reportToId])
}

model EmployeeMedia {
  id             Int       @id @default(autoincrement())
  title          String?
  category       String?
  version        String?
  visibility     String    @default("all")
  effective_date String?
  expiry_date    String?
  notes          String?   @db.Text
  employee       Employee? @relation("employeeMedia", fields: [employee_id], references: [id])
  employee_id    Int?
  media_id       Int?
  file_name      String?
  mime_type      String?
  file_size      Int?
  download_url   String?
  uploaded_by_id Int?
  uploaded_at    DateTime  @default(now())
  status         String    @default("active")

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
}

model BusinessUnit {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  employees Employee[]

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GradeLevel {
  id           Int      @id @default(autoincrement())
  name         String // e.g., "G5", "Senior", "Associate"
  description  String?
  // Payroll Setup — salary band for the grade (nullable; major units).
  minSalary    Decimal? @db.Decimal(18, 4)
  midSalary    Decimal? @db.Decimal(18, 4)
  maxSalary    Decimal? @db.Decimal(18, 4)
  bandCurrency String? // ISO 4217, e.g. "PKR"
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  employees        Employee[]
  salaryComponents SalaryComponent[]

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([tenantId, name])
  @@index([tenantId])
}

model EmergencyContacts {
  id           Int       @id @default(autoincrement())
  Contact_name String?
  relationship String?
  phone        String?
  email        String?
  is_primary   Boolean   @default(false)
  employee_Id  Int?
  employee     Employee? @relation("RelationWithEmployee", fields: [employee_Id], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([employee_Id])
}

model Log {
  id          Int       @id @default(autoincrement())
  employee    Employee? @relation(fields: [employeeId], references: [id])
  employeeId  Int?
  type        String
  action_type String
  module      String
  ip          String
  os          String
  result      String
  action_by   Employee? @relation("ActionBy", fields: [actionById], references: [id])
  actionById  Int?
  notes       String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  attendanceId Int?
  attendance   Attendance? @relation("AttendanceMark", fields: [attendanceId], references: [id])

  // Payroll relations
  payrollRun   PayrollRun?     @relation(fields: [payrollRunId], references: [id])
  payrollRunId Int?
  payslip      PayrollPayslip? @relation(fields: [payslipId], references: [id])
  payslipId    Int?

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
}

model Attendance {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  date        DateTime         @default(now())
  check_in    DateTime?
  check_out   DateTime?
  total_hours Float?
  status      StatusAttendance @default(ABSENT)
  work_mode   String? // Remote | Onsite | Hybrid — the day's work mode (WFH/Remote KPI). Mirrors Employee.work_mode values.
  remarks     String?

  // HR-ATT-POLICY-01 — the day's payable credit, in days: 1.0 full, 0.5 half,
  // 0.0 unpaid. NULL means "not yet determined" (a MISSING_* day awaiting
  // regularization). Payroll must read this rather than re-deriving policy from
  // `status`, and must treat NULL as a hold, never as zero.
  day_credit               Float?
  requires_regularization  Boolean @default(false)

  // HR-ATT-CORRECTION-01 — a day fixed by hand. The device roll-up SKIPS these:
  // without that, HR corrects a day and the next sync silently overwrites it,
  // which is the one failure that would make manual correction worthless.
  manually_corrected Boolean   @default(false)
  corrected_by_id    Int?
  corrected_at       DateTime?
  correction_reason  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  logs     Log[]    @relation("AttendanceMark")

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  // HR-ATT-IMPORT-01: one attendance row per employee per day. `date` is stored
  // at midnight (see the matching migration) so the DAY is the key — this is what
  // makes a bulk import idempotent and re-runnable without doubling history.
  @@unique([tenantId, employeeId, date], map: "Attendance_tenant_employee_day_key")
  // F-DB-07: employee history and latest-day reads are tenant-leading and
  // deterministic when multiple marks share a date.
  @@index([tenantId, employeeId, date(sort: Desc), id(sort: Desc)], map: "Attendance_tenant_employee_date_id_idx")
  @@index([tenantId, date(sort: Desc), check_in(sort: Desc), id(sort: Desc)], map: "Attendance_tenant_date_checkin_id_idx")
}

// HR-ATT-DEVICE-INTAKE-01 — durable raw store of every punch pushed by a
// biometric device over ADMS/iclock. Kept separate from Attendance (the
// rolled-up daily row): this is the append-only source of truth so a re-import
// or a mapping fix can rebuild Attendance without re-contacting the device.
// deviceUserId is the device enrolment id; it maps to Employee.biometric_id
// when the punch is rolled up. Unmatched punches are still stored here.
model AttendanceDevicePunch {
  id           Int      @id @default(autoincrement())
  sn           String   @db.VarChar(64) // device serial number (iclock SN=)
  deviceUserId String   @db.VarChar(64) // enrolment id on the device
  punchedAt    DateTime // punch timestamp as reported by the device
  status       Int      @default(0) // device status byte: 0=check-in, 1=check-out, ...
  verifyMode   Int      @default(0) // 1=fingerprint, 15=face, ...
  workCode     Int      @default(0)
  employeeId   Int? // resolved Employee.id, null when biometric_id is unknown
  rawLine      String?  @db.Text // the exact tab-separated ATTLOG row, for replay
  ingestedAt   DateTime @default(now())

  tenantId String? @db.Uuid // create-stamped from the intake tenant; FORCE-RLS

  // Idempotency: the device re-pushes the same rows on reconnect. One physical
  // punch = one (tenant, device, user, time, status).
  @@unique([tenantId, sn, deviceUserId, punchedAt, status], map: "attendance_device_punch_natural_key")
  @@index([tenantId, deviceUserId, punchedAt(sort: Desc)], map: "attendance_device_punch_user_time_idx")
  @@index([tenantId, employeeId, punchedAt(sort: Desc)], map: "attendance_device_punch_emp_time_idx")
  @@map("attendance_device_punches")
}

// Attendance anomaly / correction request. Raised by an employee ("Inform
// Abnormality"), reviewed by HR (approve/reject). Feeds the Timesheet
// pending-approvals list and the Leave & Anomaly screen.
model AttendanceAnomaly {
  id         Int           @id @default(autoincrement())
  employeeId Int
  type       AnomalyType
  reason     String?       @db.Text
  detail     String?       @db.Text // free text for OTHER {specify}
  date       DateTime? // the affected work date
  fromTime   DateTime? // time-range start
  toTime     DateTime? // time-range end
  status     AnomalyStatus @default(PENDING)
  reviewerId Int? // Employee id of the HR reviewer (no relation — plain ref)
  reviewNote String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  // HR-ATT-POLICY-01 — the request form. Everything except `reason` is filled in
  // by the system; the employee only explains themselves. Position/department
  // are SNAPSHOTS taken at raise time: a transfer months later must not rewrite
  // the record a decision was made on.
  applicationDate    DateTime @default(now()) // defaults to the raise date
  positionSnapshot   String?
  departmentSnapshot String?
  expectedTime       DateTime? // e.g. rostered shift start for a LATE_CHECKIN
  actualTime         DateTime? // e.g. the punch that was actually recorded

  // Dedup key for auto-raised anomalies. DISAPPROVED_LEAVE can arrive from BOTH
  // a rejected LeaveRequest and a rejected regularization, so the generator
  // upserts on this instead of creating one row per source.
  sourceKind String? // 'DEVICE' | 'LEAVE_REQUEST' | 'REGULARIZATION' | 'MANUAL'
  sourceRef  String? // e.g. "leaveRequest:123"

  currentApprovalLevel Int @default(1)

  employee  Employee                   @relation(fields: [employeeId], references: [id])
  approvals AttendanceAnomalyApproval[]

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  // F-DB-07: the default HR review queue filters tenant + status and sorts by
  // createdAt, with id as the stable pagination tie-break.
  @@index([tenantId, status, createdAt(sort: Desc), id(sort: Desc)], map: "attendance_anomalies_tenant_status_created_id_idx")
  @@index([employeeId])
  @@index([status])
  @@unique([tenantId, sourceKind, sourceRef], map: "attendance_anomalies_source_key")
  @@map("attendance_anomalies")
}

// HR-ATT-POLICY-01 — one decision per approval level, mirroring
// LeaveRequestApproval. The chain is defined by AttendanceApprovalLevel.
model AttendanceAnomalyApproval {
  id           Int              @id @default(autoincrement())
  anomalyId    Int
  level        Int
  approverId   Int
  approverRole String
  decision     ApprovalDecision
  comments     String?
  decidedAt    DateTime         @default(now())
  createdAt    DateTime         @default(now())

  anomaly  AttendanceAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Cascade)
  approver Employee          @relation("AttendanceAnomalyApprover", fields: [approverId], references: [id])

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([anomalyId, level])
  @@index([anomalyId])
  @@index([approverId])
  @@index([tenantId])
  @@map("attendance_anomaly_approvals")
}

// ─── Payroll Setup · Attendance ────────────────────────────────────────────
// These three models are part of the PAYROLL CONFIG SET: they carry
// ConfigStatus + version and are flipped DRAFT→PUBLISHED and snapshotted by the
// same "Publish changes" action as PayrollRuleConfig. A payroll run records the
// config version it used, so re-running a period cannot silently change pay.

// Thresholds the attendance evaluator reads. One row per tenant; a tenant with
// no row falls back to the service-level defaults.
model AttendancePolicyConfig {
  id Int @id @default(autoincrement())

  graceMinutes         Int @default(0) // PRESENT while check-in <= shiftStart + this
  halfDayAfterMinutes  Int @default(30) // HALF_DAY once lateness >= this (fixed minutes)

  // When set, the half-day threshold is this PERCENT of the employee's own
  // rostered shift instead of the fixed minutes above. Required because policy
  // here is "half the shift" for four of the five tenants, and half a shift is
  // 90 minutes for EMG's 3-hour roster but 360 for Homenet's 12-hour one — a
  // single integer cannot express it. Null keeps the fixed-minutes behaviour.
  halfDayAfterPercentOfShift Float?
  earlyLeaveGraceMin   Int @default(0) // EARLY_CHECKOUT once check-out < shiftEnd - this
  checkoutLeniencyMin  Int @default(240) // how long past shift end a check-out still counts
  overtimeAfterMinutes Int @default(45) // OT only past this much beyond shift end
  overtimeNeedsApproval Boolean @default(true)

  // Duration bands as a PERCENTAGE of the rostered shift, never absolute hours:
  // this fleet runs shifts from 3h (EMG 15:30-18:30) to 12h (Homenet 22:00-10:00),
  // so a fixed "<4h = absent" rule would mark whole teams absent every day.
  fullDayMinPercent Float @default(90)
  halfDayMinPercent Float @default(50)

  // Anti-passback: identical punches inside this window collapse to one.
  duplicatePunchWindowMin Int @default(5)

  // Sessionisation gap; mirrors ATTENDANCE_SHIFT_GAP_HOURS.
  shiftGapHours Int @default(11)

  defaultShiftStart String @default("09:00")

  status    ConfigStatus @default(DRAFT)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId])
  @@map("attendance_policy_config")
}

enum AttendanceDeductionRuleKey {
  DISAPPROVED_LEAVE
  LATE
  MISSING_CHECKIN // deliberately separate from MISSING_CHECKOUT: a missing
  MISSING_CHECKOUT // check-out is routine on this device, a missing check-in is not
  EARLY_CHECKOUT
}

// "N occurrences in a period cost X days of salary." triggerCount = 1 means the
// deduction applies per occurrence (how DISAPPROVED_LEAVE is used).
model AttendanceDeductionRule {
  id      Int                        @id @default(autoincrement())
  ruleKey AttendanceDeductionRuleKey
  enabled Boolean                    @default(false) // OFF until a dry-run is reviewed

  triggerCount  Int   @default(1) // N
  deductionDays Float @default(0.5) // X — fractional allowed (0.5 = half day)

  // Counting window. PAY_PERIOD follows PayrollCalendar.
  periodScope String @default("PAY_PERIOD") // 'PAY_PERIOD' | 'MONTH'

  // Rules sharing a counterGroup POOL their occurrences into one counter, so
  // "3 missed punches of either kind = 1 day" is configuration rather than code.
  // Null means the rule counts alone. Splitting them again later is a settings
  // change, not a migration. Rules in one group must agree on N/X/scope/cap —
  // enforced on write, so the UI can present a group as a single row.
  counterGroup String?

  maxDeductionDaysPerPeriod Float? // cap per employee per period

  status    ConfigStatus @default(DRAFT)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId, ruleKey])
  @@index([tenantId])
  @@map("attendance_deduction_rules")
}

// The anomaly approval chain: level 1 first, ascending. A level whose approver
// cannot be resolved is SKIPPED, not blocked — that is the "if the manager does
// not exist, hop to the next" rule. `useEmployeeManager` resolves the approver
// dynamically from the requester's manager instead of a fixed person.
model AttendanceApprovalLevel {
  id                  Int       @id @default(autoincrement())
  level               Int // 1 = first approver
  role                String // 'MANAGER' | 'HR' | 'MANAGEMENT' | free text
  approverId          Int? // fixed approver; null when resolved dynamically
  useEmployeeManager  Boolean   @default(false)
  skipIfUnresolved    Boolean   @default(true)
  autoEscalateAfterHours Int?

  rowStatus RowStatus    @default(ACTIVE)
  status    ConfigStatus @default(DRAFT)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  approver Employee? @relation("AttendanceApprover", fields: [approverId], references: [id])

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId, level])
  @@index([tenantId])
  @@map("attendance_approval_levels")
}

