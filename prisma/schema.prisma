}

model PayrollDeductionType {
  id          Int            @id @default(autoincrement())
  tenantId    String?        @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  code        String
  name        String
  description String?
  type        PayElementType @default(DEDUCTION)
  rate        Decimal?       @db.Decimal(8, 6)
  preTax      Boolean        @default(false) // whether the deduction is applied pre-tax (hr_payroll_deduction_type_create)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  // Relations
  deductions  PayrollDeduction[]
  assignments PayrollAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("payroll_deduction_types")
}

model EmploymentTerms {
  id              Int          @id @default(autoincrement())
  tenantId        String?      @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  employeeId      Int
  // HR-01 / T-P4.2 — C4 salary/comp encrypted at rest (was Float). Stored as a
  // self-describing AES-256-GCM envelope string; the prisma C4 extension
  // decrypts to a Number on read so callers (payroll/analytics) are unchanged.
  baseSalary      String
  currency        String       @default("USD")
  payFrequency    PayFrequency
  bonusTarget     String? // HR-01 / T-P4.2 — C4 bonus encrypted at rest (was Float?)
  // Equity component (RSUs/options/grant value) — free-form, C4-encrypted at rest
  // (C4_FIELDS.employmentTerms.equity). Additive nullable. Job & Comp tab.
  equity          String?
  equalityDetails String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id])

  // F-DB-08: payroll selects the latest effective terms for each employee.
  @@index([tenantId, employeeId, effectiveFrom(sort: Desc), id(sort: Desc)], map: "employment_terms_tenant_employee_effective_id_idx")
  @@map("employment_terms")
}

model PayrollAssignment {
  id              Int       @id @default(autoincrement())
  tenantId        String?   @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  employeeId      Int
  earningTypeId   Int?
  deductionTypeId Int?
  amount          Decimal?  @db.Decimal(18, 4) // F-12 / ARCH-01 §5.1
  rate            Decimal?  @db.Decimal(8, 6)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relations
  employee      Employee              @relation(fields: [employeeId], references: [id])
  earningType   PayrollEarningType?   @relation(fields: [earningTypeId], references: [id])
  deductionType PayrollDeductionType? @relation(fields: [deductionTypeId], references: [id])

  // F-DB-08: active employee assignments are evaluated by effective window.
  @@index([tenantId, employeeId, isActive, effectiveFrom(sort: Desc), id(sort: Desc)], map: "payroll_assignments_tenant_employee_active_effective_id_idx")
  @@map("payroll_assignments")
}

model Loan {
