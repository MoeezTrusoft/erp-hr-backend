model BankDetail {
  id                 Int      @id @default(autoincrement())
  tenantId           String?  @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  employeeId         Int
  bankName           String
  // HR-01 / T-P4.2 — C4 bank account encrypted at rest (AES-256-GCM envelope).
  // GCM uses a random IV so ciphertext differs per write, which would break the
  // old @@unique([employeeId, accountNumber]) and any lookup-by-account. The
  // accountNumberBidx column below holds a deterministic HMAC (blind index) of
  // the plaintext; uniqueness and equality lookups move to it (see the prisma
  // C4 extension). The encrypted value still lives in accountNumber.
  accountNumber      String
  accountNumberBidx  String? // HR-01 / T-P4.2 — deterministic HMAC of the plaintext account for unique + lookup
  routingNumber      String? // HR-01 / T-P4.2 — C4 routing number encrypted at rest
  accountType        String   @default("CHECKING")
  // Consolidated-profile fields (additive nullable).
  accountTitle       String? // A/C Title — name the account is held under
  iban               String? // C4-encrypted at rest (C4_FIELDS.bankDetail.iban); embeds the account number
  branch             String? // bank branch name / code
  disbursementMethod String? // how net pay is disbursed: Bank Transfer | Cheque | Cash
  isPrimary          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id])

  // HR-01 / T-P4.2 — uniqueness moved off the (now-encrypted) accountNumber to
  // its blind index so a duplicate account is still rejected.
  @@unique([employeeId, accountNumberBidx])
  @@index([tenantId])
  @@map("bank_details")
}

model TaxRate {
  id            Int       @id @default(autoincrement())
  tenantId      String?   @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  countryCode   String    @db.Char(2)
  bracketMin    Decimal   @db.Decimal(18, 4) // F-12 / ARCH-01 §5.1
  bracketMax    Decimal?  @db.Decimal(18, 4) // F-12 / ARCH-01 §5.1
  rate          Decimal   @db.Decimal(8, 6)
  // Payroll Setup (FBR-style slabs): baseTax = cumulative tax up to bracketMin;
  // status toggles a slab active/inactive without deleting it.
  baseTax       Decimal   @default(0) @db.Decimal(18, 4) // F-12 / ARCH-01 §5.1
  status        RowStatus @default(ACTIVE)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // F-DB-08: rule snapshots load one tenant/country and evaluate effective
  // windows; id resolves equal effective dates deterministically.
  @@index([tenantId, countryCode, effectiveFrom(sort: Desc), effectiveTo, id], map: "tax_rates_tenant_country_effective_id_idx")
  @@map("tax_rates")
}

// ==================== PAYROLL SETUP (config screen) ====================

// Salary Structure — a unified, state-of-the-art salary component. `computation`
// selects how the amount is derived: FIXED (value), PERCENTAGE (value% of a base),
// or FORMULA (safe-evaluated expression referencing other component codes + the
// payroll variables BASIC/GROSS/DAYS_WORKED/WORKING_DAYS/LWP_DAYS). Optionally
// scoped to a grade band via gradeLevelId.
model SalaryComponent {
  id           Int             @id @default(autoincrement())
  code         String // referenced by other components' formulas (unique per tenant)
  name         String
  type         PayElementType // EARNING | DEDUCTION
  computation  ComputationType @default(FIXED)
  value        Decimal?        @db.Decimal(18, 4) // FIXED amount or PERCENTAGE percent (0-100)
  formula      String? // FORMULA expression (payrollFormula.js), required when computation=FORMULA
  taxable      Boolean         @default(true)
  active       Boolean         @default(true)
  sortOrder    Int             @default(0)
  gradeLevelId Int? // optional band/grade scoping
  status       ConfigStatus    @default(DRAFT) // draft until the config is published
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id])

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([gradeLevelId])
  @@map("salary_components")
}

// Cycle & Calendar — one config row per tenant. Period/pay-date boundaries use a
// CalendarAnchor (+ explicit date when FIXED_DATE). attendanceCutoff also LOCKS
// shift/OT entry edits; approvalsClose bars approvals after it; payDateWeekendShift
// pulls a weekend pay date earlier to the nearest working day.
model PayrollCalendar {
  id                  Int            @id @default(autoincrement())
  payFrequency        PayFrequency   @default(MONTHLY)
  periodStartAnchor   CalendarAnchor @default(FIRST_OF_MONTH)
  periodStartDate     DateTime?
  periodEndAnchor     CalendarAnchor @default(LAST_OF_MONTH)
  periodEndDate       DateTime?
  attendanceCutoff    DateTime? // date+time; locks shift + OT entries
  approvalsClose      DateTime? // date+time; no approvals after
  payDateAnchor       CalendarAnchor @default(LAST_OF_MONTH)
  payDate             DateTime?
  payDateWeekendShift Boolean        @default(true)
  status              ConfigStatus   @default(DRAFT)
  version             Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId])
  @@map("payroll_calendars")
}

// Approval Matrix — an ordered approval level for payroll (higher level = higher
// authority). Optional monetary threshold + an auto-escalate deadline.
model PayrollApprovalMatrix {
  id                Int       @id @default(autoincrement())
  level             Int // 1,2,3 … (higher = higher authority)
  role              String // approving role/title
  approverId        Int? // resolved Employee approver
  thresholdRequired Boolean   @default(false)
  thresholdAmount   Decimal?  @db.Decimal(18, 4) // F-12: amount at/above which this level is required
  autoEscalateAfter DateTime? // date+time after which the request escalates
  status            RowStatus @default(ACTIVE)
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  approver Employee? @relation("PayrollApprover", fields: [approverId], references: [id])

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@index([tenantId])
  @@index([level])
  @@map("payroll_approval_matrix")
}

// Pay Rules — one config row per tenant: the six policy toggles + parameters.
model PayrollRuleConfig {
  id                      Int          @id @default(autoincrement())
  midMonthJoinerProration Boolean      @default(true) // pro-rate by calendar days from join date
  midMonthExitSettlement  Boolean      @default(true) // final settlement + gratuity + leave encashment
  lwpRecovery             Boolean      @default(true) // monthly basic ÷ working days × LWP days
  complianceHold          Boolean      @default(true) // block disbursement on unfiled EOBI/PSSF
  garnishmentRecovery     Boolean      @default(true) // loan/garnishment recovery
  garnishmentCapPct       Float        @default(33) // cap as % of net pay; roll balance forward
  offCycleRelease         Boolean      @default(true) // single-employee off-cycle disbursement
  status                  ConfigStatus @default(DRAFT)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId])
  @@map("payroll_rule_config")
}

// Payroll Setup → Pay Rules: discrete, tenant-owned policy rules (an array on
// the screen). Each rule carries a human title + description; the backend
// camel-cases the title into a stable `ruleKey` (e.g. "Mid Month Joiner
// Proration" → "midMonthJoinerProration") used as the row's machine key
// (unique per tenant). Distinct from the singleton PayrollRuleConfig toggles.
model PayrollRule {
  id          Int          @id @default(autoincrement())
  ruleKey     String // camelCased from title; unique per tenant (machine key)
  title       String // human-entered rule title
  description String? // human-entered rule description
  enabled     Boolean      @default(true)
  sortOrder   Int          @default(0)
  status      ConfigStatus @default(DRAFT) // draft until the config set is published
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId, ruleKey])
  @@index([tenantId])
  @@map("payroll_rules")
}

// Draft/Publish state for the whole payroll config set (one row per tenant).
// "Publish changes" flips DRAFT config rows → PUBLISHED, bumps publishedVersion,
// and writes a PayrollConfigSnapshot.
model PayrollConfigMeta {
  id               Int          @id @default(autoincrement())
  status           ConfigStatus @default(DRAFT)
  draftVersion     Int          @default(1)
  publishedVersion Int          @default(0)
  hasUnpublished   Boolean      @default(true)
  publishedAt      DateTime?
  publishedById    Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId])
  @@map("payroll_config_meta")
}

// An immutable published snapshot of the entire payroll config (for export + audit).
model PayrollConfigSnapshot {
  id            Int      @id @default(autoincrement())
  version       Int
  config        Json // full config set at publish time
  publishedById Int?
  publishedAt   DateTime @default(now())

  tenantId String? @db.Uuid // create-stamped from hr_current_tenant(); FORCE-RLS

  @@unique([tenantId, version])
  @@index([tenantId])
  @@map("payroll_config_snapshots")
}

model PayrollAuditLog {
  id           Int      @id @default(autoincrement())
  tenantId     String?  @db.Uuid // HR-04 / T-P2.2 + REQ-007 — RBAC Company.uuid (verified service-JWT claim; was Int companyId)
  action       String
  details      String?
  payrollRunId Int?
  payslipId    Int?
  employeeId   Int?
  oldValues    Json?
  newValues    Json?
  created_at   DateTime @default(now())

  // Relations
  payrollRun PayrollRun?     @relation(fields: [payrollRunId], references: [id])
  payslip    PayrollPayslip? @relation(fields: [payslipId], references: [id])
  employee   Employee?       @relation(fields: [employeeId], references: [id])

  // F-DB-08: tenant audit pagination is newest-first with a stable id tie-break.
  @@index([tenantId, created_at(sort: Desc), id(sort: Desc)], map: "payroll_audit_logs_tenant_created_id_idx")
  @@map("payroll_audit_logs")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  type        String? // e.g. "skill", "keyword"
  tenantId    String?  @db.Uuid // REQ-007 — RBAC Company.uuid (was Int companyId)
  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates CandidateTag[]

  @@unique([tenantId, name])
}

model Candidate {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String?
  email         String
  phone         String?
  source        String? // LinkedIn, Referral, etc.
  location      String? // city / region
  resumeUrl     String? // legacy - use resumeMediaId for new uploads
  resumeMediaId Int? // DAM asset ID for resume file
  notes         String?
  status        String   @default("active") // active | archived
  // AI resume-parsing output (skills/competencies/certifications + raw meta).
  // Additive nullable JSON; candidates have no Certification relation so their
  // extracted certs live here.
  parsedResume  Json?
  tenantId      String?  @db.Uuid // REQ-007 — RBAC Company.uuid (was Int companyId)
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // API-2 — optimistic-concurrency guard (see Employee.version).
  version Int @default(0)

  tags            CandidateTag[]
  applications    Application[]
  talentPools     TalentPool[]
  offers          Offer[]
  candidateSkills CandidateSkill[]

  @@unique([tenantId, email])
}

model CandidateSkill {
  id          Int      @id @default(autoincrement())
  candidateId Int
  // Self-contained (candidates are pre-hire, not linked to the Skill catalog):
  // name + category ('skill' | 'competency') + AI rating (score 0-100 + level).
  name        String
  category    String?  @default("skill")
  score       Int?
  level       String?
  source      String?  @default("ai-resume")
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid; nullable, fail-closed

  @@unique([candidateId, name])
  @@index([candidateId])
  @@index([tenantId])
  @@map("candidate_skills")
}

model CandidateTag {
  id          Int @id @default(autoincrement())
  candidateId Int
  tagId       Int

  candidate Candidate @relation(fields: [candidateId], references: [id])
  tag       Tag       @relation(fields: [tagId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([candidateId, tagId])
  @@index([tenantId])
}

model Application {
  id               Int      @id @default(autoincrement())
  candidateId      Int
  jobRequisitionId Int
  stage            String   @default("applied") // applied | screening | interview | offer | hired | rejected
  status           String   @default("open") // open | closed
  tenantId         String?  @db.Uuid // REQ-007 — RBAC Company.uuid (was Int companyId)
  createdById      Int?
  appliedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candidate      Candidate      @relation(fields: [candidateId], references: [id])
  jobRequisition JobRequisition @relation(fields: [jobRequisitionId], references: [id])
  interviews     Interview[]
  offer          Offer?

  @@unique([candidateId, jobRequisitionId])
  @@index([candidateId])
  @@index([jobRequisitionId])
}

model PerformanceMetric {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String? // e.g. "Core", "Leadership"
  isActive    Boolean  @default(true)
  tenantId    String?  @db.Uuid // REQ-007 — RBAC Company.uuid (was Int companyId)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewItems PerformanceReviewItem[]
}

model PerformanceReviewItem {
  id       Int     @id @default(autoincrement())
  reviewId Int
  metricId Int
  rating   Float?
  comment  String?

  review PerformanceReview @relation(fields: [reviewId], references: [id])
  metric PerformanceMetric @relation(fields: [metricId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([reviewId, metricId])
  @@index([tenantId])
}

// ==================== ONBOARDING ENUMS ====================

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskAssigneeType {
  HR
  MANAGER
  NEW_HIRE
  IT
}

enum SurveyType {
  DAY_30
  DAY_60
  DAY_90
}

// Onboarding-task category — the FE "Onboarding Portal" groups tasks by the KIND
// of setup (orthogonal to `stage`, which is the WHEN). Labels for the FE live in
// src/lib/onboardingTaxonomy.js (ONBOARDING_TASK_CATEGORY_LABELS).
enum OnboardingTaskCategory {
  IT_ACCESS_SETUP
  WORKSPACE_EQUIPMENT
  ORIENTATION_TRAINING
  HR_DOCUMENTATION
  TEAM_INTRODUCTION
  COMPLIANCE_POLICY
  OTHER
}

// ==================== ONBOARDING MODELS ====================

model OnboardingChecklist {
  id                Int              @id @default(autoincrement())
  employeeId        Int
  title             String           @default("Employee Onboarding")
  startDate         DateTime
  targetDate        DateTime?
  status            OnboardingStatus @default(NOT_STARTED)
  completedAt       DateTime?
  notes             String?
  readyToCollect    Boolean          @default(false)
  currentStage      String? // pre_joining | pre_boarding | first_week | equipment | complete
  template          String? // onboarding template name
  preboarding       Json? // { readiness:{}, itSetup:{}, engagement:{}, workspace:{} } booleans
  memberAssignments Json? // [{ employeeId, name, role }]
  activityLog       Json? // [{ at, actor, text }]
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  employee       Employee             @relation(fields: [employeeId], references: [id])
  tasks          OnboardingTask[]
  documents      OnboardingDocument[]
  surveys        OnboardingSurvey[]
  sessions       OnboardingSession[]
  buddy          OnboardingBuddy?
  portalFeedback OnboardingFeedback?

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([employeeId])
  @@map("onboarding_checklists")
}

model OnboardingSession {
  id          Int       @id @default(autoincrement())
  checklistId Int
  title       String
  sessionDate DateTime?
  fromTime    String? // "09:00"
  toTime      String? // "10:00"
  sessionType String? // orientation | training | meeting
  location    String? // room or link
  assigneeId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  tenantId String? @db.Uuid

  @@index([checklistId])
  @@index([tenantId])
  @@map("onboarding_sessions")
}

model OnboardingTask {
  id           Int                     @id @default(autoincrement())
  checklistId  Int
  title        String
  description  String?
  stage        String? // pre_joining | pre_boarding | first_week | equipment
  category     OnboardingTaskCategory? @default(OTHER) // FE Onboarding-Portal grouping (IT & Access, Workspace, ...)
  assigneeType TaskAssigneeType        @default(HR)
  assigneeId   Int? // responsible employee (any employee, incl. the onboarding person)
  dueDate      DateTime?
  completed    Boolean                 @default(false)
  completedAt  DateTime?
  sortOrder    Int                     @default(0)
  mediaId      Int?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  // Responsible employee — no DB-level FK (assigneeId may reference legacy ids);
  // Prisma resolves the join at query time so the portal can show their profile.
  assignee  Employee?           @relation("OnboardingTaskAssignee", fields: [assigneeId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([assigneeId])
  @@map("onboarding_tasks")
}

model OnboardingDocument {
  id            Int       @id @default(autoincrement())
  checklistId   Int
  employeeId    Int
  title         String
  mediaId       Int
  category      String?
  requiresSign  Boolean   @default(false)
  signedAt      DateTime?
  signedByEmpId Int?
  created_at    DateTime  @default(now())

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  employee  Employee            @relation(fields: [employeeId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@map("onboarding_documents")
}

model OnboardingBuddy {
  id          Int      @id @default(autoincrement())
  checklistId Int      @unique
  buddyId     Int
  assignedAt  DateTime @default(now())
  notes       String?

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  buddy     Employee            @relation("BuddyRelation", fields: [buddyId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@map("onboarding_buddies")
}

model OnboardingSurvey {
  id          Int        @id @default(autoincrement())
  checklistId Int
  employeeId  Int
  type        SurveyType
  responses   Json?
  submittedAt DateTime?
  created_at  DateTime   @default(now())

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  employee  Employee            @relation(fields: [employeeId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([checklistId, type])
  @@index([tenantId])
  @@map("onboarding_surveys")
}

// New-hire onboarding-experience feedback (FE Onboarding Portal → "Submit
// feedback"). A radio-questionnaire distinct from the DAY_30/60/90 surveys:
// `responses` is [{ questionId, question, answer }] validated against the
// canonical questions in src/lib/onboardingTaxonomy.js. One submission per
// checklist (upserted) so a re-submit overwrites.
model OnboardingFeedback {
  id          Int      @id @default(autoincrement())
  checklistId Int      @unique
  employeeId  Int
  responses   Json? // [{ questionId, question, answer }]
  comments    String?
  submittedAt DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  employee  Employee            @relation("OnboardingFeedbackEmployee", fields: [employeeId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([employeeId])
  @@map("onboarding_feedback")
}

// ==================== RECRUITMENT COMPLETION ENUMS ====================

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  PANEL
  FINAL
  ONSITE
  VIDEO
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

// ==================== RECRUITMENT COMPLETION MODELS ====================

model Interview {
  id              Int             @id @default(autoincrement())
  applicationId   Int
  interviewType   InterviewType
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  location        String?
  status          InterviewStatus @default(SCHEDULED)
  decision        String? // NEXT_ROUND | HOLD | REJECTED (interview outcome)
  notes           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  application  Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewers InterviewInterviewer[]
  scorecards   InterviewScorecard[]

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([applicationId])
  @@map("interviews")
}

model InterviewInterviewer {
  interviewId Int
  employeeId  Int
  status      String? // invited | accepted | declined | completed

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@id([interviewId, employeeId])
  @@index([tenantId])
  @@map("interview_interviewers")
}

model InterviewScorecard {
  id             Int       @id @default(autoincrement())
  interviewId    Int
  reviewerId     Int
  scores         Json
  overallScore   Float?
  recommendation String?
  notes          String?
  submittedAt    DateTime?
  created_at     DateTime  @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer  Employee  @relation("ScorecardReviewer", fields: [reviewerId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@unique([interviewId, reviewerId])
  @@index([tenantId])
  @@map("interview_scorecards")
}

model Offer {
  id                 Int         @id @default(autoincrement())
  applicationId      Int         @unique
  candidateId        Int
  jobRequisitionId   Int
  // HR-01 / T-P4.2 — C4 offered salary encrypted at rest (was Float). Decrypted
  // to a Number on read by the prisma C4 extension.
  salary             String
  currency           String      @default("USD")
  startDate          DateTime?
  expiryDate         DateTime?
  status             OfferStatus @default(DRAFT)
  offerLetterMediaId Int?
  notes              String?     @db.Text
  sentAt             DateTime?
  respondedAt        DateTime?
  viewedAt           DateTime?
  offerType          String? // Standard | Contract | Internship | Promotion
  employmentType     String? // Full-time | Part-time | Contract
  terms              Json? // { probationMonths, noticePeriodDays, additionalTerms, specialClauses }
  compensation       Json? // { baseSalary, currency, bonus, allowances, benefits:[...] }
  approvals          Json? // { hiringManager, hrHead, finance } each { by, decision, at, reason }
  createdById        Int?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate      @relation(fields: [candidateId], references: [id])
  jobRequisition JobRequisition @relation(fields: [jobRequisitionId], references: [id])

  // API-2 — optimistic-concurrency guard (see Employee.version).
  version Int @default(0)

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

  @@index([tenantId])
  @@index([candidateId])
  @@index([jobRequisitionId])
  @@map("offers")
}

model TalentPool {
  id          Int      @id @default(autoincrement())
  candidateId Int
  poolName    String
  notes       String?
  addedById   Int?
  addedAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])

  tenantId String? @db.Uuid // C.2 / T-P2.2 / T-P2.6 — RBAC Company.uuid (verified service-JWT claim); nullable, fail-closed

