// ==================== OUTBOX (A.4 · ARCH-01 §7–§8) ====================
//
// Transactional outbox for HR fabric events. A domain event (today
// `hr.employee.lifecycle.v1`) is written into this table INSIDE the same
// transaction as the source aggregate (Employee create/update/terminate), so
// the event and the business write commit or roll back together — no lost or
// phantom events. A separate claim/lease dispatcher (src/jobs/outbox.dispatcher
// .js) drains unpublished rows and XADDs the persisted EventEnvelope to a Redis
// stream. Mirrors erp-communication-backend's CommunicationOutbox shape.
//
// payload is the full @trusoft/contracts EventEnvelope (validate-before-write),
// whose `.payload` is the HrEmployeeLifecycleV1 ids-only payload.
model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String    @db.Uuid
  eventName     String // e.g. 'hr.employee.lifecycle.v1'
  aggregateType String // 'Employee'
  aggregateId   String // stringified source row id
  payload       Json // a conformant EventEnvelope
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  // Lease-based claim so multiple dispatcher replicas coordinate without an
  // external lock service. A row is claimable when publishedAt IS NULL AND
  // (claimedAt IS NULL OR claimExpiresAt < NOW()). claimedBy is a bounded,
  // PII-free worker id.
  claimedAt      DateTime?
  claimedBy      String?
  claimExpiresAt DateTime?

  // F-DB-06: retained for tenant-scoped operational inspection. Dispatcher
  // indexes are partial SQL indexes deployed outside Prisma transactions.
  @@index([tenantId, publishedAt])
  @@map("outbox_events")
}

// F-03 — durable projection of the RBAC account-provisioning intent. This row
// commits with Employee and contains no plaintext password.
model SystemAccountProvisioning {
  id                 String                          @id @default(uuid()) @db.Uuid
  tenantId           String                          @db.Uuid
  employeeId         Int
  status             SystemAccountProvisioningStatus @default(PENDING)
  idempotencyKey     String                          @db.Uuid
  payloadFingerprint String
  payload            Json
  actor              Json
  correlationId      String?
  attempts           Int                             @default(0)
  maxAttempts        Int                             @default(5)
  nextAttemptAt      DateTime?                       @default(now())
  claimedAt          DateTime?
  claimedBy          String?
  claimExpiresAt     DateTime?
  rbacUserId         String?
  result             Json?
  lastError          String?
  lastErrorCode      String?
  lastHttpStatus     Int?
  manualRetryCount   Int                             @default(0)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  completedAt        DateTime?

  @@unique([tenantId, employeeId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, updatedAt])
  @@map("system_account_provisioning")
}

